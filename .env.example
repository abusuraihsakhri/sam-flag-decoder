# Required for the optional FastAPI audit subsystem.
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUDIT_SECRET_KEY=replace-with-a-long-random-secret

# Optional: restrict GET /api/audit/logs; access is disabled without this key.
AUDIT_LOG_READ_KEY=replace-with-an-independent-long-random-secret

# Current implementation supports a deterministic mock only.
MODEL_PROVIDER=mock
